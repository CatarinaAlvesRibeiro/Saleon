---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{%- for item in collections.all %}{% if item.url and item.url != "/404.html" and item.url != "/obrigado/" and not item.url.endsWith(".xml") and not item.url.endsWith(".txt") %}
  <url><loc>{{ item.url | absoluto(site.url) }}</loc><lastmod>{{ dataBuild }}</lastmod>{% set pr = catalogo.produtos | produtoPorUrl(item.url) %}{% if pr and pr.produto.img %}<image:image><image:loc>{{ pr.produto.img | absoluto(site.url) }}</image:loc><image:title>{{ (pr.marca.nomeCurto + " " + pr.produto.nome) | escape }}</image:title></image:image>{% endif %}</url>
{%- endif %}{% endfor %}
</urlset>
